# -----------------------------------------------------------------------------
# VotoSeguro v1.0 — Variables de Entorno
# -----------------------------------------------------------------------------

# Entorno y Depuración
ENVIRONMENT=development
DEBUG=true

# Base de Datos PostgreSQL
# Asíncrono para FastAPI (asyncpg)
DATABASE_URL=postgresql+asyncpg://votoseguro:votoseguro_secret_2026@localhost:5432/votoseguro_db
# Síncrono para Alembic (psycopg)
SYNC_DATABASE_URL=postgresql+psycopg://votoseguro:votoseguro_secret_2026@localhost:5432/votoseguro_db

# Seguridad Criptográfica
SECRET_KEY=insecure_dev_jwt_secret_key_minimum_32_characters_long_2026
NULLIFIER_SECRET=insecure_dev_nullifier_secret_key_minimum_32_chars_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Usuario Inicial Superadministrador (PLATFORM_ADMIN)
PLATFORM_ADMIN_EMAIL=admin@votoseguro.org
PLATFORM_ADMIN_PASSWORD=AdminPlatform2026!

# Configuración del Scheduler Autónomo
RUN_EMBEDDED_SCHEDULER=true
SCHEDULER_INTERVAL_SECONDS=10

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://votoseguro.pages.dev

# Frontend Web
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Nodo Neuronal Local y Túnel Estático (Sprint 2.5)
AI_LOCAL_ENABLED=true
NGROK_STATIC_DOMAIN=repackage-remarry-reviving.ngrok-free.dev
LLM_BASE_URL=https://repackage-remarry-reviving.ngrok-free.dev/v1
LLM_MODEL_NAME=votoseguro-lfm3
LLM_TIMEOUT_SECONDS=25.0
STRICT_NEURAL_MODE=false

