{
  "expo": {
    "name": "VotoSeguro",
    "slug": "votoseguro-mobile",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "votoseguro",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0B132B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.votoseguro.mobile"
    },
    "android": {
      "package": "org.votoseguro.mobile",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Permitir fotografiar la cédula para leerla en este dispositivo.",
          "photosPermission": "Permitir seleccionar la fotografía de la cédula.",
          "microphonePermission": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Permitir comandos de voz locales en la cabina.",
          "speechRecognitionPermission": "Permitir reconocer comandos electorales sin conexión."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.5"
          }
        }
      ]
    ]
  }
}
